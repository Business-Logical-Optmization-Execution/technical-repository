# Portal Blox - variáveis de ambiente
# Copie para .env antes de subir o stack:  cp .env.example .env
# Troque os valores abaixo antes de usar em ambiente compartilhado.

# Usuário dedicado do MySQL usado pelo backend (MYSQL_USER no compose)
DB_USERNAME=blox_user
DB_PASSWORD=blox_password

# Senha do root do MySQL (apenas interna ao container do banco)
DB_ROOT_PASSWORD=root_password

# URL JDBC do backend em container (host interno "db" da rede do compose).
# Sem Docker, o backend usa o default localhost:3306 do application.properties.
DB_URL=jdbc:mysql://db:3306/controle_estoque
