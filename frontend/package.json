{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.cjs",
    "mock:reset": "node -e \"require('fs').copyFileSync('mock/db.seed.json','mock/db.json')\"",
    "dev:mock": "concurrently -k -n mock,web -c yellow,cyan \"npm:mock\" \"npm:dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "json-server": "0.17.4",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
